# Copiez ce fichier en `.env` et adaptez les valeurs.
# En production : changez TOUS les mots de passe et générez un JWT_SECRET fort
# (ex. : openssl rand -hex 32).

PORT=3000

# Secret de signature des tokens JWT (ne partagez jamais ce secret)
JWT_SECRET=changez-moi-avec-un-secret-aleatoire

# Comptes administrateurs créés au premier lancement
ADMIN1_USERNAME=admin
ADMIN1_PASSWORD=changez-moi
ADMIN2_USERNAME=partenaire
ADMIN2_PASSWORD=changez-moi
